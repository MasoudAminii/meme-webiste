// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url  	    = env("DATABASE_URL")
}


model Link {
  id            Int      @id @default(autoincrement())
  slug          String   @unique
  username      String?
  logoUrl       String?
  backgroundCss String?
  textColor     String?
  label         String?
  targetUrl     String
  position      Int      @default(0)  // ✅ Add this
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Media items: images or videos with metadata
model MediaItem {
  id          Int      @id @default(autoincrement())
  slug        String?   @unique @default(cuid())   // SEO-friendly path; DB uses cuid() if omitted
  src         String?
  description String?
  author      String?
  likes       Int      @default(0)
  shares      Int      @default(0)
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


/// About Us: consolidated content
model AboutUs {
  id                 Int     @id @default(autoincrement())
  BannerUrl          String                // Large banner image
  description        String                // Introductory paragraph
  overviewLabel      String?
  overviewContent    Int?               // long text for the overview
  statisticsLabel    String?
  statisticsContent  Int?                 // JSON for key/value metrics (Postgres Json)
  siteInfoLabel      String?
  siteInfoContent    Int?   
  contactAdminLabel  String?
  contactAdminUrl    String?   
  financialSupportLabel String?         // text about site launch/details
  financialSupportUrl String?         // text about site launch/details
}



enum Role {
  ADMIN
  WRITER
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  role      Role     @default(WRITER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


